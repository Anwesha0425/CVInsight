# =============================================================================
# CVInsight Configuration & Environment Variables
# =============================================================================

# Google Gemini API Key (Required for LLM Skill Gap Analysis & RAG QA)
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Observability & Tracing Options
# -----------------------------------------------------------------------------

# LangSmith Tracing (Recommended for LangChain / LangGraph)
# Set to 'true' to trace vector retrieval, latency, token usage, and graph steps
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=CVInsight
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Langfuse Tracing (Alternative Observability Provider)
# Uncomment to stream traces via @observe() decorator
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
